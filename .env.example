# Copy this file to .env for local development, and set the same values
# as Environment Variables in your Vercel project for production.

# Local dev: SQLite file, zero setup.
#   DATABASE_URL="file:./dev.db"
# Production: your Neon Postgres connection string (from the Neon dashboard,
# "Connection string" — use the pooled one if offered).
#   DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# Shared password that gates the /admin dashboard (event creation, the
# activity feed). Not a user account system — just one password. Pick
# something long and random; there's no username.
ADMIN_PASSWORD="change-me"
